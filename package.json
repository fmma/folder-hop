{
  "name": "folder-hop",
  "displayName": "Folder Hop",
  "description": "Navigate directories and open any folder in a new window, like Ctrl+P for folders.",
  "version": "0.1.7",
  "publisher": "fmma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fmma/folder-hop"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "open folder",
    "switch project",
    "project switcher",
    "workspace",
    "directory",
    "navigation",
    "quick pick",
    "change folder",
    "recent folders",
    "open recent"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:folder-hop.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "folder-hop.open",
        "title": "Folder Hop: Open Folder in New Window"
      }
    ],
    "keybindings": [
      {
        "command": "folder-hop.open",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      }
    ]
  }
}
